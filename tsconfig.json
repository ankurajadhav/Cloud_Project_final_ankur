{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "server.ts",
    "src/**/*",
    "tests/**/*",
    "scripts/**/*"
  ]
}
